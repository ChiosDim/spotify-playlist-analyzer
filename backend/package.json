{
  "name": "spotify-playlist-analyzer-backend",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Express API for Spotify Playlist Analyzer",
  "main": "src/index.js",
  "engines": {
    "node": ">=20.0.0"
  },
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "test": "node --experimental-vm-modules node_modules/jest/bin/jest.js",
    "test:watch": "node --experimental-vm-modules node_modules/jest/bin/jest.js --watch",
    "test:coverage": "node --experimental-vm-modules node_modules/jest/bin/jest.js --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@sentry/node": "^10.75.2",
    "@sentry/profiling-node": "^10.75.2",
    "axios": "^1.20.0",
    "compression": "^1.8.2",
    "connect-redis": "^10.0.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "csv-parser": "^3.2.1",
    "dotenv": "^18.0.3",
    "express": "^5.2.1",
    "express-session": "^1.19.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "mongoose": "^9.10.1",
    "multer": "^2.4.0",
    "passport": "^0.7.0",
    "passport-spotify": "^2.0.0",
    "pino": "^10.3.1",
    "pino-http": "^11.0.0",
    "redis": "^6.2.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.11.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-n": "^18.3.0",
    "jest": "^30.5.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.8",
    "supertest": "^7.3.0"
  }
